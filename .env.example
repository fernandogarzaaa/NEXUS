# Copy to .env.local and fill in. Without a key the agents fall back to deterministic logic.

# Pilot mode: named users with roles (viewer | operator | admin). Hash passwords with `npm run user:hash`.
# Example: [{"username":"jane","displayName":"Jane Citizen","passwordHash":"scrypt$...","tenantId":"demo","roles":["operator"]}]
NEXUS_USERS=
# Required with NEXUS_USERS: >= 32 random characters for signing session cookies.
NEXUS_SESSION_SECRET=
# Demo mode: one shared token (not production auth). Ignored when NEXUS_USERS is set.
NEXUS_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# State backend: "memory" (default, resets on restart) or "postgres".
NEXUS_STATE_BACKEND=memory
# Required when NEXUS_STATE_BACKEND=postgres. Run `npm run db:migrate` once, then
# `npm run db:seed` (or let the app seed the demo set on first start).
DATABASE_URL=
# Set to 1 for TLS with certificate verification against the system trust store.
DATABASE_SSL=
# Optional: a separate database the Postgres integration tests may wipe and reuse.
NEXUS_TEST_DATABASE_URL=

# Public read API (/api/v1). JSON array of keys; each maps to a real subject and tenant.
# Example: [{"id":"ops","secret":"change-me-at-least-16-chars","subject":"ops@example.com","tenantId":"demo","roles":["viewer"],"scopes":["read:*"]}]
# The same keys authenticate the MCP endpoint (/api/mcp). Add "request:actions" plus role
# "operator" to let a key queue approval-gated requests.
NEXUS_API_KEYS=
# Tenant this deployment serves; keys for other tenants are refused (default "demo").
NEXUS_TENANT_ID=demo

# Knowledge retrieval: ops documents to index (default docs/ops) and optional max record age.
NEXUS_OPS_DOCS_DIR=
NEXUS_RAG_MAX_AGE_HOURS=
